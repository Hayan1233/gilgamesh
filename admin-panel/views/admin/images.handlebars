<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">التحكم في الصور</h5>
                <button class="btn btn-light btn-sm" id="refreshImagesBtn">
                    <i class="fas fa-rotate"></i> تحديث
                </button>
            </div>
            <div class="card-body">
                <p class="text-muted mb-4">يمكنك حذف صور الشعارات وصور الوجهات من هذا القسم فقط.</p>

                <h6 class="mb-3"><i class="fas fa-building me-2"></i>شعارات شركات الطيران</h6>
                <div id="logosGrid" class="images-grid mb-4"></div>

                <h6 class="mb-3"><i class="fas fa-map-marked-alt me-2"></i>صور الوجهات</h6>
                <div id="destinationsGrid" class="images-grid"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تأكيد حذف الصورة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                هل أنت متأكد من حذف هذه الصورة؟
                <div class="small text-muted mt-2" id="deleteImageName"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteImage">حذف</button>
            </div>
        </div>
    </div>
</div>
