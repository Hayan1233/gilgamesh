<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="fas fa-download me-2"></i>تحميل البيانات
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- التذاكر -->
                    <div class="col-md-6 mb-4">
                        <div class="card border-primary">
                            <div class="card-header bg-primary text-white">
                                <h6 class="mb-0">
                                    <i class="fas fa-ticket-alt me-2"></i>التذاكر
                                </h6>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-3">تحميل ملف التذاكر والصور المرتبطة به</p>
                                
                                <div class="d-grid gap-2">
                                    <a href="/data.json" download="data.json" class="btn btn-primary">
                                        <i class="fas fa-file-download me-2"></i>تحميل data.json
                                    </a>
                                    <button onclick="downloadFolder('img')" class="btn btn-outline-primary">
                                        <i class="fas fa-download me-2"></i>تحميل مجلد الصور
                                    </button>
                                    <button onclick="downloadFolder('logo')" class="btn btn-outline-primary">
                                        <i class="fas fa-download me-2"></i>تحميل مجلد اللوجوهات
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- الأخبار -->
                    <div class="col-md-6 mb-4">
                        <div class="card border-info">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0">
                                    <i class="fas fa-newspaper me-2"></i>الأخبار
                                </h6>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-3">تحميل ملف الأخبار والصور المرتبطة به</p>
                                
                                <div class="d-grid gap-2">
                                    <a href="/news.json" download="news.json" class="btn btn-info">
                                        <i class="fas fa-file-download me-2"></i>تحميل news.json
                                    </a>
                                    <button onclick="downloadFolder('imgnews')" class="btn btn-outline-info">
                                        <i class="fas fa-download me-2"></i>تحميل مجلد صور الأخبار
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- معلومات إضافية -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <h6 class="mb-0">
                                    <i class="fas fa-database me-2"></i>تحميل كل بيانات الموقع
                                </h6>
                            </div>
                            <div class="card-body text-center">
                                <p class="text-muted mb-3">تحميل كل بيانات الموقع في ملف واحد مضغوط</p>
                                <button onclick="downloadAllData()" class="btn btn-success btn-lg">
                                    <i class="fas fa-download me-2"></i>تحميل كل داتا الموقع
                                </button>
                                <div class="mt-3">
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle me-1"></i>
                                        سيتم تحميل: data.json + news.json + كل المجلدات (img, imgnews, logo)
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- معلومات إضافية -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="alert alert-info">
                            <h6 class="alert-heading">
                                <i class="fas fa-info-circle me-2"></i>معلومات هامة
                            </h6>
                            <p class="mb-2">
                                <strong>data.json:</strong> يحتوي على بيانات التذاكر (شركات الطيران، الأسعار، المدن)
                            </p>
                            <p class="mb-2">
                                <strong>news.json:</strong> يحتوي على بيانات الأخبار (العناوين، المحتوى، الصور)
                            </p>
                            <p class="mb-0">
                                <strong>المجلدات:</strong> تحتوي على الصور واللوجوهات المستخدمة في الموقع
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- إحصائيات -->
                <div class="row mt-4">
                    <div class="col-md-4 mb-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h5 class="text-primary" id="ticketsCount">0</h5>
                                <p class="mb-0">تذكرة</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h5 class="text-info" id="newsCount">0</h5>
                                <p class="mb-0">خبر</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card text-center">
                            <div class="card-body">
                                <h5 class="text-success" id="imagesCount">0</h5>
                                <p class="mb-0">صورة</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden iframe for downloads -->
<iframe id="downloadFrame" style="display: none;"></iframe>

<script>
// تحميل إحصائيات البيانات عند تحميل الصفحة
document.addEventListener('DOMContentLoaded', function() {
    // جلب بيانات التذاكر
    fetch('/api/tickets')
        .then(response => response.json())
        .then(data => {
            document.getElementById('ticketsCount').textContent = data.data ? data.data.length : 0;
        })
        .catch(error => {
            document.getElementById('ticketsCount').textContent = 'خطأ';
        });
    
    // جلب بيانات الأخبار
    fetch('/api/news')
        .then(response => response.json())
        .then(data => {
            document.getElementById('newsCount').textContent = data.news ? data.news.length : 0;
        })
        .catch(error => {
            document.getElementById('newsCount').textContent = 'خطأ';
        });
    
    // حساب عدد الصور (تقريبي)
    var totalImages = 0;
    
    // عد الصور في مجلد img
    fetch('/api/files-count/img')
        .then(response => response.json())
        .then(data => {
            totalImages += data.count;
            document.getElementById('imagesCount').textContent = totalImages;
        })
        .catch(error => {
            // إذا فشل، نحاول المجلدات الأخرى
            document.getElementById('imagesCount').textContent = '?';
        });
    
    // عد الصور في مجلد imgnews
    fetch('/api/files-count/imgnews')
        .then(response => response.json())
        .then(data => {
            totalImages += data.count;
            document.getElementById('imagesCount').textContent = totalImages;
        });
    
    // عد اللوجوهات في مجلد logo
    fetch('/api/files-count/logo')
        .then(response => response.json())
        .then(data => {
            totalImages += data.count;
            document.getElementById('imagesCount').textContent = totalImages;
        });
});

// دالة تحميل المجلدات
function downloadFolder(folderName) {
    // إنشاء ZIP للمجلد وتحميله
    fetch('/api/download-folder/' + folderName)
        .then(response => {
            if (response.ok) {
                return response.blob();
            }
            throw new Error('فشل في تحميل المجلد');
        })
        .then(blob => {
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = folderName + '.zip';
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
        })
        .catch(error => {
            console.error('Error:', error);
            alert('حدث خطأ أثناء تحميل المجلد: ' + error.message);
        });
}

// دالة تحميل كل بيانات الموقع
function downloadAllData() {
    // إنشاء ZIP يحتوي على كل شيء
    fetch('/api/download-all-data')
        .then(response => {
            if (response.ok) {
                return response.blob();
            }
            throw new Error('فشل في تحميل كل البيانات');
        })
        .then(blob => {
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'website-data-complete.zip';
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
            
            // إظهار رسالة نجاح
            alert('تم تحميل كل بيانات الموقع بنجاح!');
        })
        .catch(error => {
            console.error('Error:', error);
            alert('حدث خطأ أثناء تحميل كل البيانات: ' + error.message);
        });
}
</script>
